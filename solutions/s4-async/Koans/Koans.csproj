<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>S4.Async.Koans</AssemblyName>
    <RootNamespace>Asynchrone</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NFluent" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <None Update="donnees\*;sql\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NFluent" />
    <Using Include="Dapper" />
    <Using Include="Npgsql" />
    <Using Include="Asynchrone.Blanks" Static="true" />
  </ItemGroup>

</Project>

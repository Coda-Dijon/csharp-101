{
  "name": "csharp-101-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "s1": "slidev s1-fundamentals.md --open",
    "build:s1": "slidev build s1-fundamentals.md --out dist/s1",
    "export:s1": "slidev export s1-fundamentals.md --output dist/s1-fundamentals.pdf",
    "s2": "slidev s2-types.md --open",
    "build:s2": "slidev build s2-types.md --out dist/s2",
    "export:s2": "slidev export s2-types.md --output dist/s2-types.pdf",
    "s3": "slidev s3-linq.md --open",
    "build:s3": "slidev build s3-linq.md --out dist/s3",
    "export:s3": "slidev export s3-linq.md --output dist/s3-linq.pdf",
    "s4": "slidev s4-async.md --open",
    "build:s4": "slidev build s4-async.md --out dist/s4",
    "export:s4": "slidev export s4-async.md --output dist/s4-async.pdf",
    "s5": "slidev s5-domain-model.md --open",
    "build:s5": "slidev build s5-domain-model.md --out dist/s5",
    "export:s5": "slidev export s5-domain-model.md --output dist/s5-domain-model.pdf",
    "s6": "slidev s6-aspnet.md --open",
    "build:s6": "slidev build s6-aspnet.md --out dist/s6",
    "export:s6": "slidev export s6-aspnet.md --output dist/s6-aspnet.pdf",
    "build:site": "node scripts/build-site.mjs",
    "serve:site": "node scripts/serve-site.mjs",
    "site": "npm run build:site && npm run serve:site"
  },
  "dependencies": {
    "@iconify-json/fluent-emoji-high-contrast": "1.2.6",
    "@iconify-json/game-icons": "1.2.4",
    "@iconify-json/logos": "1.2.15",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.64.1"
  }
}
